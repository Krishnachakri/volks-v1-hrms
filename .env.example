# ============================================================
# VOLKS HRMS — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env files to version control.
# ============================================================

# Environment Mode: development | staging | production
NODE_ENV=development

# Server Port
PORT=4000

# PostgreSQL Database Connection URL
# Local development (Docker):
#   DATABASE_URL=postgresql://volks:volks@localhost:5432/volks_hrms
# Production (managed DB, e.g. AWS RDS or Supabase):
#   DATABASE_URL=postgresql://volks_user:STRONG_PASSWORD@db.example.com:5432/volks_prod_db
DATABASE_URL=postgresql://volks:volks@localhost:5432/volks_hrms

# CORS Allowed Origins (comma-separated, no trailing slash)
# Development: localhost origins below are fine.
# Production: set this to your real frontend domain ONLY. No wildcards.
#   CORS_ALLOWED_ORIGINS=https://hrms.yourcompany.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Auth Rate Limiting
# Max login attempts per window per IP before HTTP 429 is returned.
# Window resets after LOGIN_RATE_WINDOW_MS milliseconds (default: 15 minutes).
# No permanent lockout — the window simply slides forward.
LOGIN_MAX_ATTEMPTS=10
LOGIN_RATE_WINDOW_MS=900000

# Trusted Proxy
# Set to true if VOLKS is behind a reverse proxy (nginx/Caddy) that sets X-Forwarded-For.
# NEVER set to true unless your proxy strips/validates X-Forwarded-For itself.
TRUSTED_PROXY=false

# Outbox Worker Batch Polling Interval (ms)
OUTBOX_POLL_INTERVAL=10000

# DB Slow Query Warning Threshold (ms)
DB_SLOW_QUERY_MS=250
