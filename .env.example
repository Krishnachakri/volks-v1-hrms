# ============================================================
# VOLKS HRMS — Environment Configuration Blueprint
# ============================================================

# Environment Mode
NODE_ENV=production

# Server Port
PORT=4000

# PostgreSQL Database Connection URL
# For production managed DB (e.g. AWS RDS or Supabase PostgreSQL):
# DATABASE_URL=postgresql://volks_user:secure_password@db.example.com:5432/volks_prod_db
DATABASE_URL=in-memory

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://hrms.example.com,http://localhost:3000

# Session Secret (Used for HMAC hashing)
SESSION_SECRET=super-secret-production-key-change-me

# Outbox Worker Batch Polling Interval (ms)
OUTBOX_POLL_INTERVAL=10000
